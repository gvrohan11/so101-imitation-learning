        <body name="ball_s0205" pos="12 10 10">
        <inertial pos="0 0 0" mass="0.0027" diaginertia="0.00000045387 0.00000045387 0.00000045387"/>
        <freejoint name="ball_s0205_free"/>
        <geom name="ball_geom_s0205" type="sphere" size="0.0205" mass="0"
                rgba="0.96 0.96 0.90 0" friction="0.8 0.01 0.05" condim="6"/>
        </body>
    </worldbody>
    <equality>
        <weld name="ball_s0195_parked" body1="ball_s0195" active="true"/>
        <weld name="ball_s0205_parked" body1="ball_s0205" active="true"/>
    </equality>
</mujoco>
